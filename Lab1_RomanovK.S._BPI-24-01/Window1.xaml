<Window x:Class="Lab1_RomanovK.S._BPI_24_01.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab1_RomanovK.S._BPI_24_01"
        mc:Ignorable="d"
        Title="Добавление сотрудника"
        Height="450" Width="420"
        MinWidth="420" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Style="{StaticResource WindowStyle}">

    <!-- Закруглённая рамка -->
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            CornerRadius="8"
            BorderBrush="{DynamicResource BorderBrushDark}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- TitleBar -->
                <RowDefinition Height="*"/>
                <!-- Контент -->
            </Grid.RowDefinitions>

            <!-- ============ TITLEBAR ============ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderGradient}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- RadioButton темы -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="15,0,0,0">
                        <RadioButton x:Name="rbDark"
                                     Content="Тёмная"
                                     GroupName="Theme"
                                     Style="{StaticResource ThemeRadioStyle}"
                                     Checked="Theme_Checked"
                                     Tag="Dark"/>
                        <RadioButton x:Name="rbLight"
                                     Content="Светлая"
                                     GroupName="Theme"
                                     Style="{StaticResource ThemeRadioStyle}"
                                     Checked="Theme_Checked"
                                     Tag="Light"/>
                    </StackPanel>

                    <!-- Заголовок -->
                    <TextBlock Grid.Column="1"
                               Text="Новый сотрудник"
                               Foreground="{DynamicResource AccentTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Кнопка закрытия -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="—"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Click="Minimize_Click"/>
                        <Button Content="✕"
                                Style="{StaticResource TitleBarCloseButtonStyle}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ КОНТЕНТ ============ -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                </Grid.ColumnDefinitions>

                <!-- Панель полей -->
                <Border Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource PanelStyle}">
                    <StackPanel Margin="15">
                        <TextBlock Text="Фамилия:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtFamiliya"
                                 Style="{StaticResource InputStyle}"
                                 PreviewTextInput="TxtFamiliya_PreviewTextInput"/>

                        <TextBlock Text="Должность:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtDolzhnost"
                                 Style="{StaticResource InputStyle}"
                                 PreviewTextInput="TxtDolzhnost_PreviewTextInput"/>

                        <TextBlock Text="Оклад:" Style="{StaticResource LabelStyle}"/>
                        <TextBox x:Name="txtOklad"
                                 Style="{StaticResource InputStyle}"
                                 PreviewTextInput="TxtOklad_PreviewTextInput"
                                 PreviewKeyDown="TxtOklad_PreviewKeyDown"/>
                    </StackPanel>
                </Border>

                <!-- Панель кнопок -->
                <Border Grid.Row="3" Grid.Column="1"
                        Style="{StaticResource PanelStyle}">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12">
                        <Button Content="Добавить"
                                Width="130"
                                Style="{StaticResource ButtonStyle}"
                                Click="BtnAdd_Clickk"/>
                        <Button Content="Отмена"
                                Width="130"
                                Style="{StaticResource ButtonStyle}"
                                IsCancel="True"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>