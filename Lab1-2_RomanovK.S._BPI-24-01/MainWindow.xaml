<Window x:Class="Lab1_2_RomanovK.S._BPI_24_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab1_2_RomanovK.S._BPI_24_01"
        mc:Ignorable="d"
        Title="Математический калькулятор" Height="400" Width="500"
        MinHeight="400" MinWidth="500"
        WindowStartupLocation="CenterScreen"
        Style="{DynamicResource WindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WindowHeaderStyle}">
            <TextBlock Text="Калькулятор функций arcsin и arccos" 
                       Style="{StaticResource WindowHeaderTextStyle}"/>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
            <StackPanel>
                <TextBlock Text="Введите число от -1 до 1:" 
                           Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="txtInput" 
                         Style="{StaticResource InputStyle}"
                         LostFocus="TxtInput_LostFocus"/>
                <Button Content="Вычислить" 
                        Style="{StaticResource ButtonStyle}"
                        Click="BtnCalculate_Click"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelStyle}">
            <StackPanel>
                <TextBlock Text="Результаты вычислений:" 
                           Style="{StaticResource PanelTitleStyle}"/>
                <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtOutput" 
                               FontSize="14" 
                               TextWrapping="Wrap" 
                               FontFamily="Segoe UI" 
                               LineHeight="22"
                               Foreground="{DynamicResource TextColor}"/>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <Button Grid.Row="3" 
                Content="О программе" 
                Style="{StaticResource ButtonStyle}"
                Click="BtnInfo_Click"
                HorizontalAlignment="Center"/>
    </Grid>
</Window>